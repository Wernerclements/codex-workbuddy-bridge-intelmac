+def _transcript_mentions_target(text: str, target: str) -> bool:
+    """Match the same target across macOS aliases without accepting a prefix."""
+    original = Path(target).expanduser().absolute()
+    canonical = original.resolve()
+    candidates = {str(original), str(canonical)}
+    # macOS exposes /var and /tmp through /private. Accept only aliases that
+    # resolve to this exact existing target; never strip arbitrary prefixes.
+    for prefix in ("/private/var/", "/private/tmp/"):
+        if str(canonical).startswith(prefix):
+            alias = str(canonical).removeprefix("/private")
+            if Path(alias).resolve() == canonical:
+                candidates.add(alias)
+    flags = re.IGNORECASE if os.name == "nt" else 0
+    for candidate in candidates:
+        pattern = r"(?<![\w./\\-])" + re.escape(candidate) + r"(?![\w./\\-])"
+        if re.search(pattern, text, flags):
+            return True
+    return False
+
